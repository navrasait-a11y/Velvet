rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - users can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['userId', 'phone'])
        && request.resource.data.userId == userId
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10;
    }

    // User profiles - public read, auth write
    match /Users_Profile/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50;
      allow delete: if false;
    }

    // User contacts - private
    match /User_Contacts/{userId}/contacts/{contactUserId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Phone savers reverse index - server-side only (backend uses Admin SDK)
    match /Phone_Savers/{phone} {
      allow read, write: if false;
    }

    // Phone index - server-side only (backend uses Admin SDK)
    match /phone_index/{phone} {
      allow read, write: if false;
    }

    // Blocked users - read/write own block list
    match /Blocked_Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reports - users can create, cannot read/update/delete
    match /Reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500;
      allow read, update, delete: if false;
    }

    // Private chat settings - read/write own
    match /Users_Private_Settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
